{
  "expo": {
    "name": "sanskrit-app",
    "slug": "sanskrit-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "native",
      "backgroundColor": "#FAF9F6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sanskritapp.learning",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
