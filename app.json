    "android": {
      "package": "com.sanskritapp.learning",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "8cfa323d-e5db-4426-b20a-c7ce9f164bfb"
      }
    }
  }
}
